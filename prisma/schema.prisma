generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  leads         Lead[]
  campaigns     Campaign[]
  messages      Message[]
  followUps     FollowUp[]
  subscription  Subscription?
  settings      Settings?
  notes         Note[]
  smtpConfig    SmtpConfig?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Lead {
  id             String     @id @default(cuid())
  userId         String
  businessName   String
  category       String
  address        String?
  city           String
  country        String
  phone          String?
  website        String?
  email          String?
  contactFormUrl String?
  rating         Float?
  leadScore      Int        @default(0)
  opportunity    Opportunity @default(LOW)
  status         LeadStatus @default(NEW)

  // Website audit fields
  hasWebsite          Boolean  @default(false)
  websiteOutdated     Boolean  @default(false)
  mobileScore         Int?
  seoScore            Int?
  opportunityScore    Int      @default(0)
  auditedAt           DateTime?

  // Google Places data
  placeId        String?
  googleMapsUrl  String?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes          Note[]
  messages       Message[]
  followUps      FollowUp[]

  @@map("leads")
}

model Campaign {
  id          String         @id @default(cuid())
  userId      String
  name        String
  description String?
  type        CampaignType   @default(EMAIL)
  status      CampaignStatus @default(DRAFT)
  template    String?
  subject     String?
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("campaigns")
}

model Message {
  id          String        @id @default(cuid())
  userId      String
  leadId      String
  campaignId  String?
  subject     String?
  content     String        @db.Text
  type        MessageType   @default(EMAIL)
  status      MessageStatus @default(DRAFT)
  sentAt      DateTime?
  openedAt    DateTime?
  repliedAt   DateTime?
  scheduledAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@map("messages")
}

model FollowUp {
  id          String         @id @default(cuid())
  userId      String
  leadId      String
  dueAt       DateTime
  notes       String?
  completed   Boolean        @default(false)
  completedAt DateTime?
  type        FollowUpType   @default(EMAIL)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("follow_ups")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  leadsUsed            Int                @default(0)
  leadsLimit           Int                @default(10)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Settings {
  id              String  @id @default(cuid())
  userId          String  @unique
  emailNotifications Boolean @default(true)
  followUpReminders  Boolean @default(true)
  weeklyDigest       Boolean @default(false)
  defaultTemplate    String?
  timezone           String  @default("UTC")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  leadId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("notes")
}

model SmtpConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  host      String
  port      Int      @default(587)
  username  String
  password  String
  fromEmail String
  fromName  String?
  secure    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("smtp_configs")
}

enum Role {
  USER
  ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  QUALIFIED
  CLOSED
}

enum Opportunity {
  HIGH
  MEDIUM
  LOW
}

enum CampaignType {
  EMAIL
  CONTACT_FORM
  SOCIAL
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum MessageType {
  EMAIL
  CONTACT_FORM
  SMS
}

enum MessageStatus {
  DRAFT
  QUEUED
  SENT
  OPENED
  REPLIED
  BOUNCED
  ARCHIVED
}

enum FollowUpType {
  EMAIL
  CALL
  MEETING
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  PAST_DUE
}
